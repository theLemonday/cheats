% git

# Change directory to git root
cd "$(git rev-parse --show-toplevel)"

# Change to a top-level directory of the repository
cd "$(git rev-parse --show-toplevel)/<dir>"

$ dir: git ls-tree -d --name-only HEAD

# Generate a .gitignore template using gibo
gibo dump <language_or_framework> >> .gitignore

$ language_or_framework: gibo list | tr ' ' '\n'
